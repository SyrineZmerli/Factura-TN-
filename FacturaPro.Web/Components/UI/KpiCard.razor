@*
    TP8 — "Dumb" / Presentation Component
    Displays one KPI metric card. Accepts all display data via [Parameter].
    Has NO business logic — only renders what the parent passes in.

    Usage:
    <KpiCard Title="Total Factures"
             Value="@total.ToString()"
             BackgroundColorClass="bg-primary"
             IconClass="bi-receipt" />
*@

<div class="card text-white @BackgroundColorClass h-100">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h6 class="card-title mb-0 opacity-75">@Title</h6>
                <h3 class="my-2 fw-bold">@Value</h3>
            </div>
            @* TP8: Bootstrap Icons (bi-* classes) from CDN added in App.razor *@
            <i class="bi @IconClass" style="font-size: 2.5rem; opacity: 0.4;"></i>
        </div>
    </div>
</div>

@code {
    // TP8: [Parameter] lets the parent page pass values like HTML attributes.
    // This component is "dumb" — it displays data but never fetches or mutates it.

    [Parameter] public string Title              { get; set; } = "KPI";
    [Parameter] public string Value              { get; set; } = "0";
    [Parameter] public string BackgroundColorClass { get; set; } = "bg-primary";
    /// <summary>Bootstrap Icons class — e.g. "bi-receipt", "bi-graph-up", "bi-exclamation-triangle-fill"</summary>
    [Parameter] public string IconClass          { get; set; } = "bi-graph-up";
}
