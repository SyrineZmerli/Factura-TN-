@page "/catalogue"
@attribute [Authorize]
@inject IProduitService ProduitService

<PageTitle>Catalogue Produits FacturaPro TN</PageTitle>

<div class="page-header">
    <h1><i class="fas fa-box-open"></i> Catalogue des Produits</h1>
</div>

<div class="search-bar">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" placeholder="Rechercher par désignation ou référence..."
               value="@searchTerm" @oninput="OnSearch" />
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @if (!produits.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
            Aucun produit trouvé
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var p in produits)
            {
                <div class="col-md-4 col-lg-3 mb-4">
                    <div class="card h-100 shadow-sm border-0" style="border-radius:12px;overflow:hidden;">
                        <div class="card-header text-white d-flex align-items-center gap-2"
                             style="background:linear-gradient(135deg,#1a3c5e,#2980b9);">
                            <i class="bi bi-box fs-5"></i>
                            <span class="fw-bold text-truncate">@p.Designation</span>
                        </div>
                        <div class="card-body d-flex flex-column gap-2 pb-2">
                            @if (!string.IsNullOrEmpty(p.Reference))
                            {
                                <div>
                                    <span class="text-muted small">Référence</span><br />
                                    <code class="fs-6">@p.Reference</code>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(p.Description))
                            {
                                <p class="text-muted small mb-0">@p.Description</p>
                            }
                            <div class="mt-auto pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="text-muted small d-block">Prix HT</span>
                                        <span class="fw-bold">@p.PrixUnitaireHT.ToString("N3") TND</span>
                                    </div>
                                    <span class="badge @GetTVABadgeClass((int)p.TauxTVA)">
                                        TVA @((int)p.TauxTVA)%
                                    </span>
                                </div>
                                <div class="mt-2 p-2 rounded text-center"
                                     style="background:#f0f7ff;">
                                    <span class="text-muted small">Prix TTC</span>
                                    <div class="fw-bold fs-5 text-primary">
                                        @((p.PrixUnitaireHT * (1 + (decimal)p.TauxTVA / 100)).ToString("N3")) TND
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<Produit> produits = new();
    private bool isLoading = true;
    private string searchTerm = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        produits = await ProduitService.GetAllAsync(searchTerm);
        isLoading = false;
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        await LoadAsync();
    }

    private string GetTVABadgeClass(int taux) => taux switch
    {
        0  => "bg-secondary",
        7  => "bg-info",
        13 => "bg-warning text-dark",
        19 => "bg-danger",
        _  => "bg-primary"
    };
}
