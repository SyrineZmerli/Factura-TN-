@page "/login"
@layout EmptyLayout
@inject IAuthService AuthService
@inject SessionUtilisateur Session
@inject NavigationManager Nav

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1a3c5e,#2980b9);">
    <div style="background:white;border-radius:16px;padding:2.5rem;width:400px;box-shadow:0 20px 60px rgba(0,0,0,0.3);">

        <div style="text-align:center;margin-bottom:2rem;">
            <i class="fas fa-file-invoice-dollar" style="font-size:3rem;color:#f39c12;"></i>
            <h2 style="color:#1a3c5e;margin:0.5rem 0 0;font-weight:700;">FacturaPro TN</h2>
            <p style="color:#666;font-size:0.9rem;margin:0.3rem 0 0;">Connectez-vous pour continuer</p>
        </div>

        @if (!string.IsNullOrEmpty(erreur))
        {
            <div style="background:#fdecea;color:#c0392b;padding:0.8rem 1rem;border-radius:8px;margin-bottom:1rem;font-size:0.9rem;">
                <i class="fas fa-exclamation-circle"></i> @erreur
            </div>
        }

        <EditForm Model="loginModel" OnValidSubmit="Connecter">
            <DataAnnotationsValidator />

            <div style="margin-bottom:1rem;">
                <label style="font-size:0.85rem;color:#555;font-weight:600;">Nom d'utilisateur</label>
                <InputText @bind-Value="loginModel.NomUtilisateur"
                           style="width:100%;padding:0.7rem;border:1.5px solid #ddd;border-radius:8px;font-size:1rem;margin-top:4px;box-sizing:border-box;"
                           placeholder="utilisateur" />
                <ValidationMessage For="@(() => loginModel.NomUtilisateur)" />
            </div>

            <div style="margin-bottom:1.5rem;">
                <label style="font-size:0.85rem;color:#555;font-weight:600;">Mot de passe</label>
                <input type="password"
                       @bind="loginModel.MotDePasse"
                       style="width:100%;padding:0.7rem;border:1.5px solid #ddd;border-radius:8px;font-size:1rem;margin-top:4px;box-sizing:border-box;"
                       placeholder="••••••••" />
                <ValidationMessage For="@(() => loginModel.MotDePasse)" />
            </div>

            <button type="submit" disabled="@chargement"
                    style="width:100%;padding:0.85rem;background:linear-gradient(135deg,#1a3c5e,#2980b9);color:white;border:none;border-radius:8px;font-size:1rem;font-weight:600;cursor:pointer;">
                @if (chargement)
                { <span><i class="fas fa-spinner fa-spin"></i> Connexion...</span> }
                else
                { <span><i class="fas fa-sign-in-alt"></i> Se connecter</span> }
            </button>
        </EditForm>

        <div style="text-align:center;margin-top:1.2rem;padding-top:1.2rem;border-top:1px solid #eee;">
            <p style="font-size:0.85rem;color:#666;margin:0;">
                Pas encore de compte ?
                <a href="/register" style="color:#27ae60;font-weight:600;text-decoration:none;">
                    <i class="fas fa-user-plus"></i> Créer un compte
                </a>
            </p>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string erreur = "";
    private bool chargement = false;

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le nom d'utilisateur est obligatoire")]
        public string NomUtilisateur { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le mot de passe est obligatoire")]
        public string MotDePasse { get; set; } = "";
    }

    protected override void OnInitialized()
    {
        if (Session.EstConnecte) Nav.NavigateTo("/");
    }

    private async Task Connecter()
    {
        chargement = true;
        erreur     = "";

        var utilisateur = await AuthService.ConnecterAsync(
            loginModel.NomUtilisateur, loginModel.MotDePasse);

        if (utilisateur != null)
        {
            Session.Connecter(utilisateur);
            Nav.NavigateTo("/");
        }
        else
        {
            erreur = "Nom d'utilisateur ou mot de passe incorrect.";
        }

        chargement = false;
    }
}
