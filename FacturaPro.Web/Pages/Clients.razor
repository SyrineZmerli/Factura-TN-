@page "/clients"
@inject IClientService ClientService
@inject NavigationManager Nav

<PageTitle>Clients — FacturaPro TN</PageTitle>

<div class="page-header">
    <h1><i class="fas fa-users"></i> Gestion des Clients</h1>
    <button class="btn btn-primary" @onclick="NouveauClient">
        <i class="fas fa-plus"></i> Nouveau Client
    </button>
</div>

<!-- Recherche -->
<div class="search-bar">
    <div class="input-group">
        <span class="input-group-text"><i class="fas fa-search"></i></span>
        <input type="text" class="form-control" placeholder="Rechercher par nom, matricule, email..."
               value="@searchTerm" @oninput="OnSearch" />
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nom</th>
                        <th>Matricule Fiscal</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Statut</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!clients.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Aucun client trouvé</td></tr>
                    }
                    else
                    {
                        @foreach (var client in clients)
                        {
                            <tr>
                                <td class="fw-bold">@client.Nom</td>
                                <td><code>@(client.MatriculeFiscale ?? "—")</code></td>
                                <td>@(client.Email ?? "—")</td>
                                <td>@(client.Telephone ?? "—")</td>
                                <td>
                                    @if (client.Actif)
                                    { <span class="badge bg-success">Actif</span> }
                                    else
                                    { <span class="badge bg-secondary">Inactif</span> }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditClient(client.Id)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteClient(client.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Modal Formulaire -->
@if (showModal)
{
    <div class="modal-overlay">
        <div class="modal-dialog-custom">
            <div class="modal-header-custom">
                <h5>@(editingClient.Id == 0 ? "Nouveau Client" : "Modifier Client")</h5>
                <button class="btn-close-custom" @onclick="CloseModal">✕</button>
            </div>
            <div class="modal-body-custom">
                <EditForm Model="editingClient" OnValidSubmit="SaveClient">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Nom *</label>
                        <InputText class="form-control" @bind-Value="editingClient.Nom" />
                        <ValidationMessage For="@(() => editingClient.Nom)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Matricule Fiscal</label>
                        <InputText class="form-control" @bind-Value="editingClient.MatriculeFiscale" placeholder="0000000/A/M/000" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adresse</label>
                        <InputTextArea class="form-control" @bind-Value="editingClient.Adresse" rows="2" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="editingClient.Email" />
                            <ValidationMessage For="@(() => editingClient.Email)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Téléphone</label>
                            <InputText class="form-control" @bind-Value="editingClient.Telephone" />
                        </div>
                    </div>
                    <div class="mb-3 form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="editingClient.Actif" />
                        <label class="form-check-label">Client actif</label>
                    </div>
                    <div class="modal-footer-custom">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Enregistrer
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Client> clients = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private bool showModal = false;
    private Client editingClient = new();

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        clients = await ClientService.GetAllAsync(searchTerm);
        isLoading = false;
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        await LoadAsync();
    }

    private void NouveauClient()
    {
        editingClient = new Client();
        showModal = true;
    }

    private async Task EditClient(int id)
    {
        editingClient = await ClientService.GetByIdAsync(id) ?? new Client();
        showModal = true;
    }

    private async Task SaveClient()
    {
        if (editingClient.Id == 0)
            await ClientService.CreateAsync(editingClient);
        else
            await ClientService.UpdateAsync(editingClient);

        showModal = false;
        await LoadAsync();
    }

    private async Task DeleteClient(int id)
    {
        await ClientService.DeleteAsync(id);
        await LoadAsync();
    }

    private void CloseModal() => showModal = false;
}
