@page "/clients"
@attribute [Authorize(Roles = "Admin")]
@inject IClientService ClientService
@inject NavigationManager Nav

<PageTitle>Clients FacturaPro TN</PageTitle>

<div class="page-header">
    <h1><i class="fas fa-users"></i> Gestion des Clients</h1>
    <button class="btn btn-primary" @onclick="NouveauClient">
        <i class="bi bi-plus-lg"></i> Nouveau Client
    </button>
</div>

<div class="search-bar">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" placeholder="Rechercher par nom, matricule, email..."
               value="@searchTerm" @oninput="OnSearch" />
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <ClientTable Clients="clients" OnEditClicked="EditClient" OnDeleteClicked="DeleteClient" />
        </div>
    </div>
}

@if (showModal)
{
    <div class="modal-overlay">
        <div class="modal-dialog-custom">
            <div class="modal-header-custom">
                <h5>@(editingClient.Id == 0 ? "Nouveau Client" : "Modifier Client")</h5>
                <button class="btn-close-custom" @onclick="CloseModal">✕</button>
            </div>
            <div class="modal-body-custom">
                <EditForm Model="editingClient" OnValidSubmit="SaveClient">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="mb-3">
                        <label class="form-label">Nom *</label>
                        <InputText class="form-control" @bind-Value="editingClient.Nom" />
                        <ValidationMessage For="@(() => editingClient.Nom)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Matricule Fiscal</label>
                        <InputText class="form-control" @bind-Value="editingClient.MatriculeFiscale" placeholder="0000000/A/M/000" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adresse</label>
                        <InputTextArea class="form-control" @bind-Value="editingClient.Adresse" rows="2" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="editingClient.Email" />
                            <ValidationMessage For="@(() => editingClient.Email)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Téléphone</label>
                            <InputText class="form-control" @bind-Value="editingClient.Telephone" />
                        </div>
                    </div>
                    <div class="modal-footer-custom">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy"></i> Enregistrer
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Client> clients = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private bool showModal = false;
    private Client editingClient = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        clients = await ClientService.GetAllAsync(searchTerm);
        isLoading = false;
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        await LoadAsync();
    }

    private void NouveauClient() { editingClient = new Client(); showModal = true; }

    private async Task EditClient(int id)
    {
        editingClient = await ClientService.GetByIdAsync(id) ?? new Client();
        showModal = true;
    }

    private async Task SaveClient()
    {
        if (editingClient.Id == 0) await ClientService.CreateAsync(editingClient);
        else await ClientService.UpdateAsync(editingClient);
        showModal = false;
        await LoadAsync();
    }

    private async Task DeleteClient(int id) { await ClientService.DeleteAsync(id); await LoadAsync(); }
    private void CloseModal() => showModal = false;
}
