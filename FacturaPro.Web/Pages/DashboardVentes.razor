@page "/dashboard-ventes"
@inject IDashboardService DashboardService
@inject IJSRuntime JS

<PageTitle>Dashboard Ventes FacturaPro TN</PageTitle>

<div class="page-header">
    <h1><i class="fas fa-chart-bar"></i> Tableau de Bord Ventes</h1>
    <select class="form-select w-auto" @bind="annee" @bind:after="LoadAsync">
        @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 4; y--)
        { <option value="@y">@y</option> }
    </select>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (data != null)
{
    @*
        TP8 Activity 1: KpiCard components instead of duplicated .kpi-card divs.
        Each card receives its unique title/value/colour/icon via [Parameter].
        NOTE: Title uses @($"...{annee}") — you cannot mix @variable inside a quoted attribute string.
    *@
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <KpiCard Title="Chiffre d'Affaires HT"
                     Value="@(data.ChiffreAffairesHT.ToString("N3") + " TND")"
                     BackgroundColorClass="bg-primary"
                     IconClass="bi-receipt" />
        </div>
        <div class="col-md-4 mb-3">
            <KpiCard Title="Chiffre d'Affaires TTC"
                     Value="@(data.ChiffreAffairesTTC.ToString("N3") + " TND")"
                     BackgroundColorClass="bg-success"
                     IconClass="bi-cash-stack" />
        </div>
        <div class="col-md-4 mb-3">
            @* FIX RZ9986 + CS1503: use @($"...") for interpolated string in component attribute *@
            <KpiCard Title="@($"Clients Actifs {annee}")"
                     Value="@(data.VentesParClient.Count.ToString())"
                     BackgroundColorClass="bg-warning"
                     IconClass="bi-people" />
        </div>
    </div>

    <div class="row mt-2">
        <!-- Bar Chart CA Mensuel -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-chart-bar"></i> CA Mensuel @annee (TND)</h5>
                </div>
                <div class="card-body">
                    <canvas id="caChart" style="max-height:300px"></canvas>
                </div>
            </div>
        </div>

        <!-- Doughnut CA par Client -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5><i class="fas fa-chart-pie"></i> CA par Client</h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="clientChart" style="max-height:250px"></canvas>
                </div>
            </div>
        </div>

        <!-- Horizontal Bar Chart CA par Produit -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5><i class="fas fa-chart-bar"></i> CA par Produit (HT)</h5>
                </div>
                <div class="card-body">
                    <canvas id="produitChart" style="max-height:250px"></canvas>
                </div>
            </div>
        </div>

        <!-- Table CA Mensuel -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-calendar-alt"></i> Détail CA Mensuel @annee</h5>
                </div>
                <div class="card-body">
                    <table class="table table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Période</th>
                                <th class="text-end">CA HT (TND)</th>
                                <th class="text-end">CA TTC (TND)</th>
                                <th>Progression</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in data.VentesParMois)
                            {
                                var pct = data.ChiffreAffairesTTC == 0
                                    ? 0m
                                    : m.MontantTTC / data.ChiffreAffairesTTC * 100;
                                <tr>
                                    <td class="fw-bold">@m.Periode</td>
                                    <td class="text-end">@m.MontantHT.ToString("N3")</td>
                                    <td class="text-end text-primary fw-bold">
                                        @m.MontantTTC.ToString("N3")
                                    </td>
                                    <td style="width:200px">
                                        <div class="progress" style="height:10px">
                                            <div class="progress-bar bg-primary"
                                                 style="@($"width:{pct:N0}%")"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Top Clients -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5><i class="fas fa-users"></i> Top Clients</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>#</th>
                                <th>Client</th>
                                <th class="text-end">CA HT</th>
                                <th class="text-end">CA TTC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < data.VentesParClient.Count; i++)
                            {
                                var c = data.VentesParClient[i];
                                <tr>
                                    <td><span class="badge bg-secondary">@(i + 1)</span></td>
                                    <td>@c.ClientNom</td>
                                    <td class="text-end">@c.MontantHT.ToString("N3")</td>
                                    <td class="text-end fw-bold text-primary">
                                        @c.MontantTTC.ToString("N3")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Top Produits -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5><i class="fas fa-boxes"></i> Top Produits</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>#</th>
                                <th>Produit</th>
                                <th class="text-center">Qté</th>
                                <th class="text-end">CA HT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < data.VentesParProduit.Count; i++)
                            {
                                var p = data.VentesParProduit[i];
                                <tr>
                                    <td><span class="badge bg-secondary">@(i + 1)</span></td>
                                    <td>@p.ProduitDesignation</td>
                                    <td class="text-center">@p.QuantiteVendue</td>
                                    <td class="text-end fw-bold">@p.MontantHT.ToString("N3")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardVentesDto? data;
    private bool isLoading = true;
    private int annee = DateTime.Now.Year;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        data = await DashboardService.GetVentesDashboardAsync(annee);
        isLoading = false;
        await Task.Delay(100);
        await RenderCharts();
    }

    private async Task RenderCharts()
    {
        if (data == null) return;

        if (data.VentesParMois.Any())
        {
            var labels = data.VentesParMois.Select(m => m.Periode).ToArray();
            var ht     = data.VentesParMois.Select(m => (double)m.MontantHT).ToArray();
            var ttc    = data.VentesParMois.Select(m => (double)m.MontantTTC).ToArray();
            await JS.InvokeVoidAsync("renderBarChart", "caChart", labels, ht, ttc);
        }
        if (data.VentesParClient.Any())
        {
            var labels = data.VentesParClient.Select(c => c.ClientNom).ToArray();
            var values = data.VentesParClient.Select(c => (double)c.MontantHT).ToArray();
            await JS.InvokeVoidAsync("renderDoughnutChart", "clientChart", labels, values);
        }
        if (data.VentesParProduit.Any())
        {
            var labels = data.VentesParProduit.Select(p => p.ProduitDesignation).ToArray();
            var values = data.VentesParProduit.Select(p => (double)p.MontantHT).ToArray();
            await JS.InvokeVoidAsync("renderHorizontalBarChart", "produitChart", labels, values);
        }
    }
}
