@page "/produits"
@attribute [Authorize(Roles = "Admin")]
@inject IProduitService ProduitService

<PageTitle>Produits FacturaPro TN</PageTitle>

<div class="page-header">
    <h1><i class="fas fa-box"></i> Gestion des Produits</h1>
    <button class="btn btn-primary" @onclick="NouveauProduit">
        <i class="bi bi-plus-lg"></i> Nouveau Produit
    </button>
</div>

<div class="search-bar">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" placeholder="Rechercher par désignation ou référence..."
               value="@searchTerm" @oninput="OnSearch" />
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            @*
                TP8 Activity 2: The repetitive <table>…</table> block is now a reusable component.
                Parent → Child: passes Produits list
                Child → Parent: fires OnEditClicked and OnDeleteClicked events
            *@
            <ProduitTable Produits="produits"
                          OnEditClicked="EditProduit"
                          OnDeleteClicked="DeleteProduit" />
        </div>
    </div>
}

@* TP7: Unified modal form for both Create and Edit modes *@
@if (showModal)
{
    <div class="modal-overlay">
        <div class="modal-dialog-custom">
            <div class="modal-header-custom">
                <h5>@(editingProduit.Id == 0 ? "Nouveau Produit" : "Modifier Produit")</h5>
                <button class="btn-close-custom" @onclick="CloseModal">✕</button>
            </div>
            <div class="modal-body-custom">
                @*
                    TP7: EditForm + DataAnnotationsValidator
                    Reads [Required], [Range] from Produit.cs automatically.
                    OnValidSubmit only fires when ALL validations pass.
                *@
                <EditForm Model="editingProduit" OnValidSubmit="SaveProduit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Désignation *</label>
                            <InputText class="form-control" @bind-Value="editingProduit.Designation" />
                            <ValidationMessage For="@(() => editingProduit.Designation)" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Référence</label>
                            <InputText class="form-control" @bind-Value="editingProduit.Reference" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Prix Unitaire HT (TND) *</label>
                            <InputNumber class="form-control" @bind-Value="editingProduit.PrixUnitaireHT" />
                            <ValidationMessage For="@(() => editingProduit.PrixUnitaireHT)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Taux TVA *</label>
                            @*
                                TP7: InputSelect binds to the FK/enum property.
                                The value syncs two-way with editingProduit.TauxTVA.
                            *@
                            <InputSelect class="form-select" @bind-Value="editingProduit.TauxTVA">
                                <option value="@TauxTVA.Exonere">0% — Exonéré</option>
                                <option value="@TauxTVA.Pct7">7%</option>
                                <option value="@TauxTVA.Pct13">13%</option>
                                <option value="@TauxTVA.Pct19">19%</option>
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" @bind-Value="editingProduit.Description" rows="2" />
                    </div>
                    <div class="modal-footer-custom">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy"></i> Enregistrer
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Produit> produits = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private bool showModal = false;
    private Produit editingProduit = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        produits = await ProduitService.GetAllAsync(searchTerm);
        isLoading = false;
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        await LoadAsync();
    }

    private void NouveauProduit() { editingProduit = new Produit(); showModal = true; }

    private async Task EditProduit(int id)
    {
        editingProduit = await ProduitService.GetByIdAsync(id) ?? new Produit();
        showModal = true;
    }

    private async Task SaveProduit()
    {
        if (editingProduit.Id == 0) await ProduitService.CreateAsync(editingProduit);
        else await ProduitService.UpdateAsync(editingProduit);
        showModal = false;
        await LoadAsync();
    }

    // TP8: This method is called by the EventCallback fired from ProduitTable child component
    private async Task DeleteProduit(int id) { await ProduitService.DeleteAsync(id); await LoadAsync(); }

    private void CloseModal() => showModal = false;
}
