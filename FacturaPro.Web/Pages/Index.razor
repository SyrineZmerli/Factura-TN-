@page "/"
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IFactureService FactureService
@inject SessionUtilisateur Session
@inject IJSRuntime JS

<PageTitle>Tableau de Bord FacturaPro TN</PageTitle>

@* TP9: <AuthorizeView Roles="Admin"> replaces @if (Session.EstAdmin) *@
<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="dashboard-header">
            <h1><i class="fas fa-tachometer-alt"></i> Tableau de Bord</h1>
            <p class="text-muted">Vue d'ensemble de votre activité @annee</p>
        </div>

        @if (isLoading)
        {
            <div class="loading-spinner">
                <div class="spinner-border text-primary" role="status"></div>
                <span>Chargement...</span>
            </div>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    <KpiCard Title="Chiffre d'Affaires TTC"
                             Value="@(ventes?.ChiffreAffairesTTC.ToString("N3") + " TND")"
                             BackgroundColorClass="bg-primary" IconClass="bi-cash-stack" />
                </div>
                <div class="col-md-3 mb-3">
                    <KpiCard Title="Chiffre d'Affaires HT"
                             Value="@(ventes?.ChiffreAffairesHT.ToString("N3") + " TND")"
                             BackgroundColorClass="bg-success" IconClass="bi-receipt" />
                </div>
                <div class="col-md-3 mb-3">
                    <KpiCard Title="TVA Collectée"
                             Value="@(fiscal?.TVATotaleCollectee.ToString("N3") + " TND")"
                             BackgroundColorClass="bg-warning" IconClass="bi-percent" />
                </div>
                <div class="col-md-3 mb-3">
                    <KpiCard Title="Timbres Fiscaux"
                             Value="@(fiscal?.MontantTotalTimbre.ToString("N3") + " TND")"
                             BackgroundColorClass="bg-danger" IconClass="bi-postage-fill" />
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header"><h5><i class="fas fa-chart-pie"></i> TVA par Taux</h5></div>
                        <div class="card-body">
                            @if (fiscal?.TVAParTaux != null)
                            {
                                <table class="table table-sm">
                                    <thead><tr><th>Taux</th><th class="text-end">Montant TVA (TND)</th></tr></thead>
                                    <tbody>
                                        @foreach (var item in fiscal.TVAParTaux)
                                        {
                                            <tr>
                                                <td><span class="badge bg-primary">@item.Key</span></td>
                                                <td class="text-end fw-bold">@item.Value.ToString("N3")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header"><h5><i class="fas fa-crown"></i> Top Clients</h5></div>
                        <div class="card-body">
                            @if (ventes?.VentesParClient != null)
                            {
                                <table class="table table-sm">
                                    <thead><tr><th>Client</th><th class="text-end">CA HT (TND)</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in ventes.VentesParClient.Take(5))
                                        {
                                            <tr>
                                                <td>@c.ClientNom</td>
                                                <td class="text-end">@c.MontantHT.ToString("N3")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mt-4">
                <div class="card-header"><h5><i class="fas fa-chart-line"></i> Ventes Mensuelles @annee</h5></div>
                <div class="card-body"><canvas id="adminMonthChart" style="max-height:280px"></canvas></div>
            </div>
        }
    </Authorized>

    @* TP9: <NotAuthorized> inside <AuthorizeView Roles="Admin"> = logged in but not Admin = Client user *@
    <NotAuthorized>
        <div class="dashboard-header">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#1a3c5e,#2980b9);display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-user" style="color:white;font-size:1.5rem;"></i>
                </div>
                <div>
                    <h1 style="margin:0;font-size:1.8rem;">
                        Bienvenue, <span style="color:#2980b9;">@(Session.Utilisateur?.NomComplet ?? Session.Utilisateur?.NomUtilisateur)</span> 👋
                    </h1>
                    <p class="text-muted mb-0">
                        @if (Session.Utilisateur?.Client != null)
                        { <span><i class="fas fa-building me-1"></i>@Session.Utilisateur.Client.Nom</span> }
                        <span class="ms-3"><i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dddd dd MMMM yyyy")</span>
                    </p>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-spinner">
                <div class="spinner-border text-primary" role="status"></div>
                <span>Chargement de vos données...</span>
            </div>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    <KpiCard Title="Total Factures"
                             Value="@mesFactures.Count.ToString()"
                             BackgroundColorClass="bg-primary" IconClass="bi-file-earmark-text" />
                </div>
                <div class="col-md-3 mb-3">
                    <KpiCard Title="Factures Validées"
                             Value="@mesFactures.Count(f => f.Statut == StatutFacture.Validee).ToString()"
                             BackgroundColorClass="bg-success" IconClass="bi-check-circle" />
                </div>
                <div class="col-md-3 mb-3">
                    <KpiCard Title="Total TTC"
                             Value="@(mesFactures.Sum(f => f.TotalTTC).ToString("N3") + " TND")"
                             BackgroundColorClass="bg-warning" IconClass="bi-cash" />
                </div>
                <div class="col-md-3 mb-3">
                    <KpiCard Title="En attente"
                             Value="@mesFactures.Count(f => f.Statut == StatutFacture.Brouillon).ToString()"
                             BackgroundColorClass="bg-danger" IconClass="bi-clock-history" />
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-7 mb-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-file-invoice"></i> Mes Dernières Factures</h5>
                            <a href="/factures" class="btn btn-sm btn-outline-primary">Voir tout</a>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-dark">
                                    <tr><th>N°</th><th>Date</th><th class="text-end">TTC (TND)</th><th class="text-center">Statut</th></tr>
                                </thead>
                                <tbody>
                                    @if (!mesFactures.Any())
                                    { <tr><td colspan="4" class="text-center text-muted py-4">Aucune facture</td></tr> }
                                    @foreach (var f in mesFactures.OrderByDescending(f => f.DateFacture).Take(6))
                                    {
                                        <tr>
                                            <td><code class="fw-bold">@f.Numero</code></td>
                                            <td>@f.DateFacture.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end fw-bold text-primary">@f.TotalTTC.ToString("N3")</td>
                                            <td class="text-center"><span class="badge @GetStatutClass(f.Statut)">@f.Statut</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-5 mb-4">
                    <div class="card h-100">
                        <div class="card-header"><h5 class="mb-0"><i class="fas fa-chart-bar"></i> Mes Factures par Mois</h5></div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <canvas id="clientMonthChart" style="max-height:260px"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    private DashboardFiscalDto? fiscal;
    private DashboardVentesDto? ventes;
    private List<Facture> mesFactures = new();
    private bool isLoading = true;
    private int annee = DateTime.Now.Year;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        isLoading = true;
        if (Session.EstAdmin)
        {
            fiscal = await DashboardService.GetFiscalDashboardAsync(annee);
            ventes = await DashboardService.GetVentesDashboardAsync(annee);
            isLoading = false;
            await Task.Delay(100);
            await RenderAdminChart();
        }
        else
        {
            var clientId = Session.Utilisateur?.ClientId;
            mesFactures = clientId.HasValue
                ? await FactureService.GetAllAsync(null, null, clientId)
                : new();
            isLoading = false;
            await Task.Delay(100);
            await RenderClientChart();
        }
    }

    private async Task RenderAdminChart()
    {
        if (ventes == null || !ventes.VentesParMois.Any()) return;
        var labels = ventes.VentesParMois.Select(m => m.Periode).ToArray();
        var ht     = ventes.VentesParMois.Select(m => (double)m.MontantHT).ToArray();
        var ttc    = ventes.VentesParMois.Select(m => (double)m.MontantTTC).ToArray();
        await JS.InvokeVoidAsync("renderBarChart", "adminMonthChart", labels, ht, ttc);
    }

    private async Task RenderClientChart()
    {
        var grouped = mesFactures
            .Where(f => f.DateFacture.Year == annee)
            .GroupBy(f => f.DateFacture.Month)
            .OrderBy(g => g.Key).ToList();
        if (!grouped.Any()) return;
        var labels = grouped.Select(g => new DateTime(annee, g.Key, 1).ToString("MMM")).ToArray();
        var values = grouped.Select(g => (double)g.Sum(f => f.TotalTTC)).ToArray();
        await JS.InvokeVoidAsync("renderDoughnutChart", "clientMonthChart", labels, values);
    }

    private string GetStatutClass(StatutFacture s) => s switch
    {
        StatutFacture.Validee => "bg-success",
        StatutFacture.Annulee => "bg-danger",
        _                     => "bg-warning text-dark"
    };
}
